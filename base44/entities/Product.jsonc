{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "price": {
      "type": "number",
      "description": "Price in COP"
    },
    "category": {
      "type": "string",
      "enum": [
        "combos",
        "helados",
        "malteadas",
        "especialidades",
        "cafe",
        "galletas",
        "paletas_packs",
        "popsy_toy",
        "para_llevar",
        "tortas",
        "regalos",
        "bebidas",
        "adiciones"
      ],
      "description": "Product category"
    },
    "emoji": {
      "type": "string",
      "description": "Category emoji"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "video_url": {
      "type": "string",
      "description": "Product video URL"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether product is available"
    },
    "tag": {
      "type": "string",
      "enum": [
        "mas_vendido",
        "recomendado",
        "promo",
        "none"
      ],
      "default": "none",
      "description": "Product tag"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sort order within category"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}