{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "number",
      "description": "Sequential order number"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "items": {
      "type": "array",
      "description": "Order items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Order total in COP"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "pagado_tarjeta",
        "finalizado"
      ],
      "default": "pendiente",
      "description": "Order status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "efectivo",
        "tarjeta"
      ],
      "description": "Payment method"
    }
  },
  "required": [
    "order_number",
    "customer_name",
    "items",
    "total",
    "status"
  ]
}