{
  "name": "Store",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Store name"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for the store (e.g. chapinero)"
    },
    "address": {
      "type": "string",
      "description": "Store address"
    },
    "schedule": {
      "type": "string",
      "description": "Store schedule (e.g. Lun-Dom 10am\u201310pm)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the store is active"
    },
    "has_cookie_jaar": {
      "type": "boolean",
      "default": true,
      "description": "Whether the store has Cookie Jaar products"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}